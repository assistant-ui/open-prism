{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        ".wrangler/**",
        "dist/**"
      ],
      "env": [
        "OPENAI_API_KEY",
        "LATEX_API_URL"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  },
  "globalEnv": [],
  "globalDependencies": [
    ".env",
    ".env.local"
  ]
}
